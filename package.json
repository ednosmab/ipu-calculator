  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "expo-secure-store": "~55.0.16",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
