{
  "name": "calculadora-ipu",
  "main": "expo-router/entry",
  "version": "1.2.28",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:lint": "jest --testPathPatterns=\"design-system\"",
    "test:core": "jest --testPathPatterns=\"core\"",
    "test:features": "jest --testPathPatterns=\"features\"",
    "test:integration": "jest --testPathPatterns=\"(Screen|useCalculatorLogic)\"",
    "build": "npx expo export --platform web && node scripts/inject-sw-version.js",
    "build:preview": "npm run build && npx --yes serve dist",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.19",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.104.1",
    "babel-preset-expo": "~55.0.8",
    "expo": "^55.0.0",
    "expo-background-fetch": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.16",
    "expo-modules-core": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.20",
    "expo-task-manager": "~55.0.18",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "sentry-expo": "~7.0.0",
    "zod": "^4.3.6"
